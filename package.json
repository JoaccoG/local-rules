  },
  "keywords": [
    "cellular-automata",
    "webgpu",
    "wgsl",
    "neural-cellular-automata",
    "lenia",
    "conway",
    "reaction-diffusion",
    "interactive-essay",
    "generative-art"
  ],
  "scripts": {
